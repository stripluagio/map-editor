{
  "name": "map-editor",
  "version": "2.0.0",
  "private": true,
  "description": "浏览器里的 2D 游戏地图编辑器 — 四种网格、路点编辑、A* 寻路可视化、数据与 EasyMapEditor 互通",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node tests/unit.test.cjs && node tests/e2e.cjs",
    "test:unit": "node tests/unit.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
